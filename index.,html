    <title>Constancia de Situación Fiscal — SAT</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }
        body {
            background: #ffffff;
            padding: 20px;
            max-width: 800px;
            margin: 0 auto;
            color: #000000;
        }

        /* === ENCABEZADO MEJORADO === */
        .header-top {
            text-align: center;
            margin-bottom: 15px;
        }
        .header-logos {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 60px;
            margin-bottom: 8px;
        }
        .header-hacienda, .header-sat {
            font-size: 22px;
            font-weight: bold;
            color: #702041;
        }
        .linea-separadora {
            border-bottom: 2px solid #702041;
            width: 100%;
            margin-bottom: 15px;
        }
        .gob-mex-title {
            font-size: 18px;
            font-weight: bold;
            color: #702041;
            margin-bottom: 5px;
            text-align: center;
        }
        .subtitulo {
            font-size: 15px;
            color: #333333;
            margin-bottom: 10px;
            text-align: center;
        }
        .fecha-hora {
            font-size: 13px;
            color: #555555;
            text-align: right;
            margin-bottom: 20px;
        }

        /* === BARRA RFC === */
        .rfc-bar {
            background: #F8F9FA;
            border: 1px solid #CED4DA;
            border-radius: 4px;
            padding: 8px 15px;
            font-size: 15px;
            margin-bottom: 20px;
        }

        /* === SECCIONES === */
        .section-box {
            border: 1px solid #B59978;
            border-radius: 4px;
            margin-bottom: 18px;
            overflow: hidden;
        }
        .section-header {
            background: #B59978;
            color: #FFFFFF;
            padding: 6px 16px;
            font-size: 15px;
            font-weight: bold;
        }
        .data-row {
            display: flex;
            border-bottom: 1px solid #E8E4DD;
        }
        .data-label {
            width: 230px;
            background: #F8F7F5;
            padding: 9px 20px;
            font-size: 14px;
        }
        .data-value {
            flex: 1;
            padding: 9px 20px;
            font-size: 14px;
        }

        /* === TARJETAS DE AYUDA === */
        .help-cards {
            display: flex;
            justify-content: space-between;
            align-items: stretch;
            flex-wrap: wrap;
            gap: 20px;
            margin: 30px 0;
        }
        .card-left, .card-right {
            width: 48%;
            min-width: 300px;
        }
        .card-left-inner {
            background: #F5F1EB;
            border-radius: 4px;
            padding: 25px 20px;
            height: 100%;
        }
        .card-right-inner {
            background: #902038;
            color: #FFFFFF;
            border-radius: 4px;
            padding: 25px 20px;
            height: 100%;
        }
        .card-right p {
            margin-bottom: 12px;
            font-size: 14px;
            line-height: 1.5;
        }
        .recuerda-box {
            background: #FFFFFF;
            color: #000000;
            padding: 8px 12px;
            border-radius: 4px;
            margin-top: 15px;
            font-size: 12px;
            line-height: 1.5;
        }

        /* === PIE DE PÁGINA === */
        .footer {
            border-top: 1px solid #E0E0E0;
            margin-top: 20px;
            padding-top: 25px;
            text-align: center;
        }
        .footer-logos {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 30px;
            margin-bottom: 15px;
        }
        .footer-hacienda {
            font-size: 26px;
            font-weight: bold;
            color: #702041;
        }
        .footer-sat {
            font-size: 26px;
            font-weight: bold;
            color: #00529B;
        }
        .footer-bar {
            background: #B59978;
            color: #FFFFFF;
            padding: 10px;
            font-size: 14px;
            margin-top: 15px;
        }
    </style>
</head>
<body>

